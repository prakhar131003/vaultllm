# ─────────────────────────── llama.cpp server ───────────────────────────
LLAMACPP_URL=http://127.0.0.1:8080
# OpenAI-compatible URL where llama.cpp is exposing embeddings + chat.
# Must be running before you boot the FastAPI backend.

# ─────────────────────────── Vector database ───────────────────────────
DB_PATH=data/knowledge.db
# Path to the sqlite-vec database file. Created on first run.

UPLOAD_DIR=data/uploads
# Where uploaded source documents are kept (PDF/TXT/MD).

# ─────────────────────────── Embedding model ───────────────────────────
EMBEDDING_MODEL=Llama-3.2-1B-Instruct
# Display name for the embedding model loaded inside llama.cpp.

EMBEDDING_DIM=2048
# Embedding vector width produced by the model. MUST match the
# dimensionality baked into DB_PATH at first ingest; an existing DB
# will be left as-is. If you change this, delete data/knowledge.db
# so it's re-created at the new dimension.

# ─────────────────────────── Chunking ───────────────────────────
CHUNK_SIZE=800
# Target tokens per chunk when splitting documents.

CHUNK_OVERLAP=150
# Token overlap between consecutive chunks to preserve context.

# ─────────────────────────── Throughput ───────────────────────────
BATCH_SIZE=32
# Number of chunks embedded per request to llama.cpp.

MAX_UPLOAD_MB=50
# Maximum size (in MB) of a single uploaded document.
