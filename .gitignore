# ─────────────────────────── Secrets / env ───────────────────────────
.env
.env.bak
.env.local
*.local

# ─────────────────────────── Runtime data ───────────────────────────
# Vector DB, uploads, logs and similar runtime artifacts are kept out
# of source control. .gitkeep files preserve the directory layout.
data/*
!data/.gitkeep

# ─────────────────────────── Model weights ───────────────────────────
# LLAMA GGUF weights are huge and licensed separately. Users fetch
# them via ./scripts/download-model.sh.
models/*
!models/.gitkeep

# ─────────────────────────── Python ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ─────────────────────────── Node / Vite ───────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# ─────────────────────────── Logs ───────────────────────────
*.log
logs/
backend/logs/

# ─────────────────────────── OS / editor ───────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────── Build artifacts ───────────────────────────
build/
dist/
*.spec
